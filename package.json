{
  "name": "livr",
  "version": "2.11.0",
  "description": "Lightweight validator supporting Language Independent Validation Rules Specification",
  "homepage": "https://github.com/koorchik/js-validator-livr",
  "author": {
    "name": "koorchik",
    "url": "https://github.com/koorchik"
  },
  "license": "MIT",
  "main": "./lib/LIVR.js",
  "types": "types/index.d.ts",
  "files": [
    "lib",
    "async.js",
    "types",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./lib/LIVR.js",
      "import": "./lib/LIVR.js"
    },
    "./async": "./async.js",
    "./async.js": "./async.js",
    "./types": {
      "types": "./types/index.d.ts"
    },
    "./types/inference": {
      "types": "./types/inference.d.ts"
    },
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm run test:unit && tsc --noEmit",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"t/tests-sync/*.js\" \"t/tests-async/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/koorchik/js-validator-livr.git"
  },
  "bugs": {
    "url": "https://github.com/koorchik/js-validator-livr/issues"
  },
  "keywords": [
    "validator",
    "validation",
    "livr",
    "schema",
    "sanitize"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
